# Copy to .env and change what you need. All values are optional.

# Image version from ghcr.io: latest, or a release like 1.0.0
IMAGE_TAG=latest

# Input device: "auto" (first capture card), "test" (sine tone, no card),
# or an ALSA name, e.g. hw:CARD=SC1,DEV=0 (see: arecord -l).
# A device chosen in the web page is saved and wins over this value.
AUDIO_DEVICE=auto

# Recording format (defaults fit the Fifine SC1: 48 kHz, 16-bit, 2 channels)
FORMAT=flac            # flac | wav
SAMPLE_RATE=48000
CHANNELS=2
BIT_DEPTH=16           # 16 | 24
RECORD_MONO=off        # off | left | right | mix  (guitar on one channel -> left)

# Share the input between recorder, level meter and headphone monitor (ALSA dsnoop).
# false = open hw: directly (only use this if dsnoop does not work; no SW monitor then).
USE_DSNOOP=true

# Software headphone monitor (alsaloop). "auto" = headphone output of the same card.
PLAYBACK_DEVICE=auto
MONITOR_DEFAULT=off
MONITOR_LATENCY_US=10000

# Safety limits
MAX_DURATION_MIN=120
MIN_FREE_DISK_MB=1000

# Time zone (for the date/time in file names)
TZ=Europe/Prague

# Owner of the recording files (default 1000). Check yours with: id
# PUID=1000
# PGID=1000

# Web port
PORT=8080
