# Copy to .env and change what you need:  cp .env.example .env

# ---- Cloudflare tunnel (HTTPS from the internet) --------------------------
# Remove "tunnel" to run without it (LAN only).
COMPOSE_PROFILES=tunnel
# Zero Trust -> Networks -> Tunnels -> your tunnel -> the token (starts with "eyJ")
TUNNEL_TOKEN=

# ---- Sound card ------------------------------------------------------------
# "auto" = first USB card, "test" = test tone (no card needed),
# or an ALSA name like hw:CARD=SC1,DEV=0 (see: arecord -l).
# A device chosen in the web page is saved and wins over this value.
AUDIO_DEVICE=auto
CHANNELS=2             # 1 for a mono USB mic / adapter
SAMPLE_RATE=48000
BIT_DEPTH=16           # 16 | 24
RECORD_MONO=off        # off | left | right | mix  (save a mono file)

# ---- Files -----------------------------------------------------------------
FORMAT=flac            # flac | wav
MAX_DURATION_MIN=120   # stop after this time
MIN_FREE_DISK_MB=1000  # stop when the disk is this full
TZ=Europe/Prague       # time in file names
# PUID=1000            # owner of the files on the host (check with: id)
# PGID=1000

# ---- Other -----------------------------------------------------------------
HOST_PORT=8080         # port of the web page in your LAN
IMAGE_TAG=latest       # or a release like 1.0.0

# Advanced (usually leave as is)
USE_DSNOOP=true        # share the input between recorder, meter and monitor
PLAYBACK_DEVICE=auto   # headphone output for the software monitor
MONITOR_DEFAULT=off
MONITOR_LATENCY_US=10000
